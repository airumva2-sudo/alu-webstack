#!/usr/bin/env bash
# Displays information about a domain's subdomains

domain=$1

check_subdomain() {
    local subdomain=$1
    local record

    record=$(dig "$subdomain.$domain" +noall +answer | awk 'NF >= 5 {print $4, $5; exit}')

    read -r record_type destination <<< "$record"

    echo "The subdomain $subdomain is a $record_type record and points to $destination"
}

if [ "$2" ]; then
    check_subdomain "$2"
else
    for subdomain in www lb-01 web-01 web-02
    do
        check_subdomain "$subdomain"
    done
fi
